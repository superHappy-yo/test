__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.venv/
venv/
build/
dist/
.DS_Store
.experiments/

# Generated by `python -m shapefuse`. SCHEMA.md stays in the tree.
results/*
!results/.gitkeep
!results/SCHEMA.md

# Crash dumps. Do not use core.*: that would also hide core.py.
/core
core.[0-9]*
*.core
*.dmp

# Local experiment outputs; keep reproduction and methodology documentation.
/paper/data/jsa_*/*
!/paper/data/jsa_*/README.md
!/paper/data/jsa_v2/ALGORITHM_AUDIT.md
!/paper/data/jsa_ablation/NEXT_EXPERIMENT.md

# Packaged manuscripts and compiled output; figures remain versioned inputs.
/artifacts/
/paper/jsa-overleaf.zip

# LaTeX build intermediates.
/paper/jsa/*.aux
/paper/jsa/*.bbl
/paper/jsa/*.blg
/paper/jsa/*.log
/paper/jsa/*.out
/paper/jsa/*.toc
/paper/jsa/*.lof
/paper/jsa/*.lot
/paper/jsa/*.fls
/paper/jsa/*.fdb_latexmk
/paper/jsa/*.synctex.gz
/paper/jsa/*.xdv
/paper/jsa/*.abs
/paper/jsa/*.spl
